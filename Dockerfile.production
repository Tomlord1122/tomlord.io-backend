# Multi-stage build for production
FROM golang:1.24.4-alpine AS builder

# Install git and ca-certificates (needed for dependencies)
RUN apk add --no-cache git ca-certificates tzdata

# Create non-root user
RUN adduser -D -g '' appuser

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download
RUN go mod verify

# Copy source code
COPY . .

# Build the binary with optimizations
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags='-w -s -extldflags "-static"' \
    -a -installsuffix cgo \
    -o main cmd/api/main.go

# TODO:[PRODUCTION] Install migrate tool for database migrations
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go install -tags 'postgres' github.com/golang-migrate/migrate/v4/cmd/migrate@latest

# Production stage - Use alpine instead of scratch to support migrate tool and SSH
FROM alpine:3.20.1 AS prod

# Install necessary runtime dependencies including shell
RUN apk add --no-cache ca-certificates tzdata bash

# Create non-root user in alpine
RUN adduser -D -g '' appuser

# Copy timezone data
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo

# Copy CA certificates
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# Copy binary
COPY --from=builder /app/main /main

# TODO:[PRODUCTION] Copy migrate tool from builder stage
COPY --from=builder /go/bin/migrate /usr/local/bin/migrate

# Copy migrations for migration jobs
COPY --from=builder /app/migrations /migrations

# Make migrate executable
RUN chmod +x /usr/local/bin/migrate

USER appuser

# Expose port
# TODO:[PRODUCTION] Update this port if your production environment uses a different port
EXPOSE 8080

# Health check
# TODO:[PRODUCTION] Update health check endpoint if needed
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["/main", "health"] || exit 1

# Run the binary
ENTRYPOINT ["/main"] 