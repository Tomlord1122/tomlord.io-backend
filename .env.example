PORT=8080
APP_ENV=local
BLUEPRINT_DB_HOST=psql_bp
BLUEPRINT_DB_PORT=5432
BLUEPRINT_DB_DATABASE=blueprint
BLUEPRINT_DB_USERNAME=melkey
BLUEPRINT_DB_PASSWORD=password1234
BLUEPRINT_DB_SCHEMA=public

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Session Configuration
SESSION_SECRET=your-session-secret-change-in-production

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# TODO:[PRODUCTION] Update this to your production callback URL
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback

# Frontend Configuration
# TODO:[PRODUCTION] Update this to your production frontend URL
FRONTEND_URL=http://localhost:5173

# CORS Configuration
# TODO:[PRODUCTION] Set this to your production domains (comma-separated)
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# If not set, will fallback to FRONTEND_URL
ALLOWED_ORIGINS=